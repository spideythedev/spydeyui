      "$type": "dimension",
      "$value": "1.25rem"
    },
    "6": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "8": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "10": {
      "$type": "dimension",
      "$value": "2.5rem"
    },
