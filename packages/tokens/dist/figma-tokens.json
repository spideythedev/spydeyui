      "$type": "dimension",
      "$value": "3rem"
    },
    "16": {
      "$type": "dimension",
      "$value": "4rem"
    },
    "20": {
      "$type": "dimension",
      "$value": "5rem"
    },
    "24": {
      "$type": "dimension",
      "$value": "6rem"
    },
    "32": {
      "$type": "dimension",
      "$value": "8rem"
    },
    "px": {
